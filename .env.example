# ─────────────────────────────────────────────────────────────
# SECRETO — SOLO SERVIDOR (sin prefijo VITE_)
# Lo usa la Netlify Function netlify/functions/chat.js.
# NUNCA se incluye en el bundle del cliente.
# En Netlify: Site settings → Environment variables.
# Obtén una key gratis en: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# ─────────────────────────────────────────────────────────────
# PÚBLICAS (prefijo VITE_) — se exponen en el bundle del cliente.
# No pongas secretos aquí.
# ─────────────────────────────────────────────────────────────

# Datos de la clínica (se muestran en la UI, PDF, emails y system prompt)
VITE_CLINIC_NAME=Clínica Dental Sonrisa Perfecta
VITE_CLINIC_ADDRESS=Av. Principal 123
VITE_CLINIC_PHONE=+34 900 123 456
VITE_CLINIC_EMAIL=info@sonrisaperfecta.com
VITE_CLINIC_DOCTOR=Dr. Alejandro Martínez

# Moneda de los precios (adaptable por clínica). Símbolo o código: € (def.), $, £, MXN, USD…
VITE_CLINIC_CURRENCY=€
# Posición del símbolo respecto al importe: after (def., "60€") | before ("$60")
VITE_CLINIC_CURRENCY_POSITION=after

# Google Calendar (opcional — sincronización de citas)
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
